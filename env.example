# =============================================================================
# STEM TOYS E-COMMERCE - ENVIRONMENT CONFIGURATION
# =============================================================================

# =============================================================================
# CORE APPLICATION
# =============================================================================
NODE_ENV=development
NEXTAUTH_SECRET=your-super-secret-key-here-minimum-32-characters
NEXTAUTH_URL=http://localhost:3000
CRON_SECRET=your-cron-secret-key-for-background-jobs
NEXT_PUBLIC_CRON_SECRET_TOKEN=your-cron-secret-key-for-background-jobs

# =============================================================================
# DATABASE CONFIGURATION (Neon PostgreSQL)
# =============================================================================
DATABASE_URL=postgresql://username:password@host:port/database
DIRECT_URL=postgresql://username:password@host:port/database
DATABASE_POOL_SIZE=20
DATABASE_CONNECTION_TIMEOUT=2000
DATABASE_IDLE_TIMEOUT=30000

# =============================================================================
# REDIS CONFIGURATION (Upstash)
# =============================================================================
REDIS_URL=https://your-redis-url.upstash.io
REDIS_TOKEN=your-redis-token
REDIS_TIMEOUT=1000
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=1000

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# Unified email provider configuration
# Options: resend | brevo | gmail
EMAIL_PROVIDER=resend
EMAIL_PRIMARY_API_KEY=your-primary-email-api-key
EMAIL_FALLBACK_API_KEY=your-fallback-email-api-key
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=TechTots STEM Store
EMAIL_REPLY_TO=support@yourdomain.com

# Legacy/provider-specific keys (optional; used by adapters when selected)
RESEND_API_KEY=your-resend-api-key
BREVO_API_KEY=your-brevo-api-key
BREVO_SMTP_KEY=your-brevo-smtp-key
GMAIL_USER=your-gmail-user@example.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# =============================================================================
# PERFORMANCE MONITORING
# =============================================================================
PERFORMANCE_MONITORING=true
PERFORMANCE_SAMPLE_RATE=0.1
PERFORMANCE_MAX_METRICS=1000
PERFORMANCE_RETENTION_DAYS=7
SLOW_QUERY_THRESHOLD=1000
CRITICAL_QUERY_THRESHOLD=5000

# =============================================================================
# API CACHING
# =============================================================================
API_CACHING=true
API_CACHE_TTL=300
API_CACHE_MAX_TTL=3600
API_CACHE_STALE_WHILE_REVALIDATE=60
API_CACHE_COMPRESSION=true

# =============================================================================
# AUTHENTICATION (Google OAuth)
# =============================================================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# =============================================================================
# PAYMENT PROCESSING
# =============================================================================

# Stripe Configuration (Commented out - for future rollback)
# STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
# STRIPE_DEFAULT_CURRENCY=ron
# NEXT_PUBLIC_STRIPE_CURRENCY=ron

# Netopia Payments Configuration (Active Provider)
NETOPIA_API_KEY=your-netopia-api-key
NETOPIA_SIGNATURE=your-netopia-signature-key
NETOPIA_MERCHANT_ID=your-netopia-merchant-id
NETOPIA_SANDBOX=true
NETOPIA_WEBHOOK_SECRET=your-netopia-webhook-secret

# Payment Provider Selection
PAYMENT_PROVIDER=netopia
NEXT_PUBLIC_PAYMENT_PROVIDER=netopia

# Gradual Rollout Configuration
GRADUAL_ROLLOUT_PERCENTAGE=0
NEXT_PUBLIC_NETOPIA_ENABLED=true
# NEXT_PUBLIC_STRIPE_ENABLED=true  # Commented out

# =============================================================================
# MONITORING & ANALYTICS
# =============================================================================
SENTRY_DSN=https://your-sentry-dsn
SENTRY_ENVIRONMENT=development
LOG_LEVEL=info
ENABLE_ANALYTICS=false

# Analytics Configuration
ANALYTICS_CONVERSION_MULTIPLIER=25
ANALYTICS_CONVERSION_SIMULATION=0.9

# =============================================================================
# UPLOAD & STORAGE
# =============================================================================
UPLOADTHING_SECRET=sk_live_your-uploadthing-secret
UPLOADTHING_APP_ID=your-uploadthing-app-id

# =============================================================================
# RICH TEXT EDITOR (TinyMCE)
# =============================================================================
NEXT_PUBLIC_TINYMCE_API_KEY=your-tinymce-api-key

# =============================================================================
# AI ENHANCEMENT CONFIGURATION
# =============================================================================
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key
# AI Core Configuration
AI_PROVIDER=openai
AI_MODEL=gpt-5-mini
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7
AI_ENHANCEMENT_ENABLED=true

# AI Dual-Provider Configuration (for blog generation)
AI_PRIMARY_PROVIDER=openai
AI_PRIMARY_MODEL=gpt-5-mini
AI_SECONDARY_PROVIDER=openai
AI_SECONDARY_MODEL=gpt-5-mini
AI_FALLBACK_MODEL=gpt-4o

# =============================================================================
# INNGEST CONFIGURATION (Background Jobs)
# =============================================================================
# Inngest is used for long-running background jobs (AI blog generation, etc.)
# For local development: Run `npx inngest-cli@latest dev` in a separate terminal
# No keys needed for local dev server - it runs on localhost:8288
# For production: Sign up at https://app.inngest.com/ and get your keys
INNGEST_EVENT_KEY=your-inngest-event-key-here
INNGEST_SIGNING_KEY=your-inngest-signing-key-here

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
NEXT_PUBLIC_SITE_URL=https://techtots.com
NEXT_PUBLIC_BASE_URL=https://techtots.com
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# =============================================================================
# GOOGLE ANALYTICS 4
# =============================================================================
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# =============================================================================
# GOOGLE SEARCH CONSOLE (GSC) - Romanian SEO Tracking
# =============================================================================
GSC_SERVICE_ACCOUNT_EMAIL=your-gsc-service-account@your-project.iam.gserviceaccount.com
GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"
GSC_SITE_URL=https://techtots.ro

# =============================================================================
# FACEBOOK PIXEL - Romanian Viral Content Tracking
# =============================================================================
FACEBOOK_PIXEL_ID=your-facebook-pixel-id
FACEBOOK_ACCESS_TOKEN=your-facebook-access-token-for-conversions-api
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# =============================================================================
# DEVELOPMENT & DEBUGGING
# =============================================================================
# Enable detailed logging in development
DEBUG=*
# Enable performance profiling
PROFILING=true
# Enable database query logging
DB_LOGGING=true

# =============================================================================
# PERFORMANCE OPTIMIZATION & SCALING
# =============================================================================
# Performance monitoring
PERFORMANCE_ALERTS_ENABLED=false
MAX_RESPONSE_TIME=5000
MAX_MEMORY_USAGE=1024
MAX_CPU_USAGE=80
MAX_ERROR_RATE=5
MAX_QUEUE_LENGTH=100
MIN_CACHE_HIT_RATE=80
MAX_SLOW_QUERIES=10
SLOW_QUERY_THRESHOLD=1000

# Alert configuration
ALERT_COOLDOWN_PERIOD=300000
ALERT_CHANNELS=email
ALERT_WEBHOOK_URL=https://your-alert-webhook.com
ALERT_EMAILS=admin@yourdomain.com

# Load balancing
ENABLE_LOAD_BALANCING=false
LOAD_BALANCER_INSTANCES=["https://instance1.yourdomain.com","https://instance2.yourdomain.com"]
LOAD_BALANCER_ALGORITHM=round-robin
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000
MAX_RETRIES=3
SESSION_AFFINITY=false

# Database optimization
DATABASE_POOL_SIZE=20
DATABASE_MIN_CONNECTIONS=2
DATABASE_ACQUIRE_TIMEOUT=60000
DATABASE_CREATE_TIMEOUT=30000
DATABASE_DESTROY_TIMEOUT=5000
DATABASE_REAP_INTERVAL=1000
DATABASE_CREATE_RETRY_INTERVAL=200
DB_LOGGING=false

# Cache configuration
API_CACHE_TTL=300
API_CACHE_MAX_TTL=3600
API_CACHE_STALE_WHILE_REVALIDATE=60
API_CACHE_COMPRESSION=true
API_CACHE_COMPRESSION_THRESHOLD=1024

# =============================================================================
# SECURITY & RATE LIMITING
# =============================================================================
# Rate limiting configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Provider selection for rate limiting: auto | redis | memory
RATE_LIMIT_PROVIDER=auto
# Request size limits
MAX_REQUEST_SIZE=10485760

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
# Cart cache TTL (seconds)
CART_CACHE_TTL=600
# Product cache TTL (seconds)
PRODUCT_CACHE_TTL=1800
# User session cache TTL (seconds)
SESSION_CACHE_TTL=3600

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_REAL_TIME_FEATURES=false
ENABLE_AI_RECOMMENDATIONS=false
ENABLE_ADVANCED_ANALYTICS=false
ENABLE_AUTOMATED_TESTING=false

# =============================================================================
# DEPLOYMENT & SCALING
# =============================================================================
# Auto-scaling configuration
ENABLE_AUTO_SCALING=false
MIN_INSTANCES=1
MAX_INSTANCES=10
# CDN configuration
CDN_ENABLED=false
CDN_URL=https://your-cdn-url.com

# =============================================================================
# BACKUP & RECOVERY
# =============================================================================
# Database backup configuration
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# =============================================================================
# NOTIFICATIONS & ALERTS
# =============================================================================
# Slack webhook for alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your-webhook
# Email alerts
ALERT_EMAIL=support@yourdomain.com
# Admin notifications
ADMIN_EMAIL=admin@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com
# Performance alert thresholds
PERFORMANCE_ALERT_THRESHOLD=5000
ERROR_RATE_ALERT_THRESHOLD=0.05 

