# =============================================================================
# STEM TOYS3 - LAUNCH ENVIRONMENT TEMPLATE
# =============================================================================
# 1) Copy this file to .env.local for local testing.
# 2) Add the same keys in Vercel (Production/Preview/Development as needed).
# 3) Never commit real secrets.
#
# Required for launch stack in this project:
# - PostgreSQL + Prisma
# - NextAuth
# - Netopia payments (Romania)
# - FAN Courier AWB
# - Supplier sync for Boribon + Kidstory
# - Email notifications
# =============================================================================

# =============================================================================
# CORE (REQUIRED)
# =============================================================================
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://your-domain.ro
NEXT_PUBLIC_BASE_URL=https://your-domain.ro
NEXT_PUBLIC_APP_URL=https://your-domain.ro
NEXTAUTH_URL=https://your-domain.ro
NEXTAUTH_SECRET=replace-with-64-char-random-secret
CHECKOUT_ADMIN_ONLY=false

# Cron auth: keep these 3 in sync with the same value
CRON_SECRET=replace-with-random-cron-secret
CRON_SECRET_TOKEN=replace-with-random-cron-secret
NEXT_PUBLIC_CRON_SECRET_TOKEN=replace-with-random-cron-secret

# Security keys used by auth/crypto utilities
ENCRYPTION_KEY=replace-with-32-or-more-char-secret
CSRF_SECRET_KEY=replace-with-random-csrf-secret
JWT_SECRET=replace-with-random-jwt-secret
SECURITY_QUESTIONS_KEY=replace-with-random-security-questions-secret
REVALIDATION_SECRET=replace-with-random-revalidation-secret

# =============================================================================
# DATABASE (REQUIRED)
# =============================================================================
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
DIRECT_DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Optional compatibility/fallback URLs used by some scripts/runtime fallbacks
POSTGRES_URL=
DATABASE_URL_POOLED=
NEON_DATABASE_URL=
DIRECT_URL=

# Optional connection tuning
DATABASE_POOL_SIZE=20
DATABASE_CONNECTION_TIMEOUT=2000
DATABASE_IDLE_TIMEOUT=30000
DATABASE_ACQUIRE_TIMEOUT=60000
DATABASE_CREATE_TIMEOUT=30000
DATABASE_DESTROY_TIMEOUT=5000
DATABASE_REAP_INTERVAL=1000
DATABASE_CREATE_RETRY_INTERVAL=200
DATABASE_MIN_CONNECTIONS=2

# =============================================================================
# CACHE / REDIS (RECOMMENDED FOR PRODUCTION)
# =============================================================================
DISABLE_REDIS=false
REDIS_URL=https://your-redis.upstash.io
REDIS_TOKEN=your-upstash-token
UPSTASH_REDIS_REST_URL=https://your-upstash-rest-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
REDIS_TIMEOUT=1000
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=1000

# Optional API cache tuning
API_CACHING=true
API_CACHE_TTL=300
API_CACHE_MAX_TTL=3600
API_CACHE_STALE_WHILE_REVALIDATE=60
API_CACHE_COMPRESSION=true
API_CACHE_COMPRESSION_THRESHOLD=1024
CACHE_DURATION=300000

# =============================================================================
# PAYMENTS (REQUIRED FOR CHECKOUT)
# =============================================================================
# Provider selection and frontend flags
PAYMENT_PROVIDER=netopia
NEXT_PUBLIC_PAYMENT_PROVIDER=netopia
NEXT_PUBLIC_NETOPIA_ENABLED=true
NEXT_PUBLIC_STRIPE_ENABLED=false

# Netopia (required if PAYMENT_PROVIDER=netopia)
NETOPIA_API_KEY=your-netopia-api-key
NETOPIA_SIGNATURE=your-netopia-signature
NETOPIA_SANDBOX=false
# NETOPIA_WEBHOOK_SECRET accepts escaped newlines if needed
NETOPIA_WEBHOOK_SECRET=-----BEGIN PUBLIC KEY-----\nYOUR_KEY\n-----END PUBLIC KEY-----
NETOPIA_API_BASE_URL=
NETOPIA_MERCHANT_ID=
NETOPIA_DEBUG_MODE=false

# Stripe (optional, enable only if NEXT_PUBLIC_STRIPE_ENABLED=true)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_DEFAULT_CURRENCY=ron
NEXT_PUBLIC_STRIPE_CURRENCY=ron

# Payment rollout controls (optional)
GRADUAL_ROLLOUT_PERCENTAGE=0
ROLLOUT_STRATEGY=percentage
TARGET_COUNTRIES=RO
TARGET_LOCALES=ro,ro-RO

# COD limits (set both server and public to avoid mismatch)
COD_MAX_B2C=10000
COD_MAX_B2B=5000
NEXT_PUBLIC_COD_MAX_B2C=10000
NEXT_PUBLIC_COD_MAX_B2B=5000

# Legacy COD controls (optional)
COD_MINIMUM_ORDER_VALUE=0
COD_MAXIMUM_AMOUNT=10000
COD_FIXED_FEE=0
COD_FEE_PERCENTAGE=0

# =============================================================================
# SHIPPING / COURIER
# =============================================================================
# Shipping price config used in checkout calculations
SHIPPING_PRICING_VERSION=fancourier-2026-01-30
SHIPPING_EASYBOX_BASE_PRICE=19
SHIPPING_HOME_BASE_PRICE=25
SHIPPING_ADDITIONAL_KG_PRICE=2.5
SHIPPING_FUEL_INDEX_PERCENT=0
SHIPPING_EXTRA_RETEA_FEE=8.39
SHIPPING_ATIPIC_FEE=50
SHIPPING_APPLY_FUEL_INDEX=false
SHIPPING_APPLY_EXTRA_RETEA=false
SHIPPING_APPLY_ATIPIC_FEE=false

# FAN Courier (required for automated AWB)
FANCOURIER_BASE_URL=https://api.fancourier.ro
FANCOURIER_CLIENT_ID=123456
FANCOURIER_USERNAME=your-fancourier-username
FANCOURIER_PASSWORD=your-fancourier-password
FANCOURIER_FANBOX_CACHE_MINUTES=30
NEXT_PUBLIC_FANCOURIER_WIDGET_SRC=https://unpkg.com/map-fanbox-points@latest/umd/map-fanbox-points.js

# FAN Courier sender profile (business pickup point)
FANCOURIER_SENDER_NAME=Your Company SRL
FANCOURIER_SENDER_PHONE=+40XXXXXXXXX
FANCOURIER_SENDER_EMAIL=logistics@your-domain.ro
FANCOURIER_SENDER_COUNTY=Cluj
FANCOURIER_SENDER_LOCALITY=Cluj-Napoca
FANCOURIER_SENDER_STREET=Mehedinti
FANCOURIER_SENDER_NUMBER=54-56
FANCOURIER_SENDER_POSTAL_CODE=400000
FANCOURIER_SENDER_CONTACT_PERSON=

# Use supplier pickup address for FanCourier AWB (dropshipping). Requires supplier to have
# businessAddress, businessCity, businessState, phone filled. Default: false (uses env sender).
# Set to "true" only after verifying with FanCourier that the AWB sender is used for pickup.
# FANCOURIER_USE_SUPPLIER_ADDRESS=false
# Disable AWB email notifications to suppliers (useful for production tests).
# When true, AWB is still created, but supplier email sending is skipped.
# DISABLE_SUPPLIER_AWB_EMAIL=false
# For COD AWBs, FAN may require info.returnPayment (who pays return transfer).
# Common values: sender / recipient (confirm with your FAN account settings).
# FANCOURIER_RETURN_PAYMENT=sender

# Optional AWB options (comma/space separated FAN option codes)
# Applied to all shipments (example: A,S)
# FANCOURIER_AWB_OPTIONS=
# Applied only to Standard shipments
# FANCOURIER_AWB_OPTIONS_STANDARD=
# Applied only to FANbox shipments. Option "V" is auto-added by code.
# FANCOURIER_AWB_OPTIONS_FANBOX=

# Sameday (optional; keep empty if unused)
SAMEDAY_USERNAME=
SAMEDAY_PASSWORD=
SAMEDAY_BASE_URL=https://api.sameday.ro
SAMEDAY_TOKEN_HEADER=X-AUTH-TOKEN
SAMEDAY_CREATE_AWB_PATH=/api/awb
SAMEDAY_PICKUP_POINTS_PATH=/api/pickup-points
SAMEDAY_SERVICES_PATH=/api/services
SAMEDAY_COUNTIES_PATH=/api/counties
SAMEDAY_CITIES_PATH=/api/cities
SAMEDAY_REFERENCE_TTL_MINUTES=1440

# =============================================================================
# SUPPLIERS / DROPSHIPPING (REQUIRED FOR YOUR CURRENT SETUP)
# =============================================================================
# Global supplier fallback email for notifications
SUPPLIER_EMAIL=suppliers@your-domain.ro

# Supplier-specific contacts used in workflow
BORIBON_SUPPLIER_EMAIL=contact@boribon.ro
KIDSTORY_SUPPLIER_EMAIL=orders@kidstory.ro
KIDSTORY_SUPPLIER_PHONE=0700000000

# Supplier feed setup / resync helpers
BORIBON_FEED_URLS=https://www.boribon.ro/feed/products/feed1,https://www.boribon.ro/feed/products/feed2
BORIBON_ALLOWED_SKUS_FILE=feed_suppliers/boribon_allowed_skus.csv
BORIBON_COST_LOOKUP_FILE=feed_suppliers/boribon_dropshipping.csv
BORIBON_CSV_PATH=
BORIBON_CLEANUP_MODE=safe
ALLOW_BORIBON_CLEANUP=false

KIDSTORY_FEED_URL=https://gomagcdn.ro/domains/kidstory.ro/files/feed/products.csv
KIDSTORY_ALLOWED_SKUS_FILE=feed_suppliers/kidstory_allowed_skus.csv

# Optional seeding safety toggles
SEED_PRODUCTS_CSV_PATH=
ALLOW_LOCAL_PRODUCT_PURGE=false
TARGET_MARGIN=25

# =============================================================================
# EMAIL (REQUIRED IF YOU SEND ORDER/SUPPLIER EMAILS)
# =============================================================================
# Supported: resend | brevo | gmail
EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@your-domain.ro
EMAIL_FROM_NAME=STEM Toys
EMAIL_REPLY_TO=support@your-domain.ro
EMAIL_DOMAIN=your-domain.ro
EMAIL_PRIMARY_API_KEY=
EMAIL_FALLBACK_API_KEY=

# Resend
RESEND_API_KEY=

# Brevo
BREVO_API_KEY=
BREVO_SMTP_KEY=
BREVO_SMTP_LOGIN=

# Gmail SMTP
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Generic SMTP fallback
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=

# =============================================================================
# STORE / LEGAL / SUPPORT (RECOMMENDED)
# =============================================================================
# VAT mode:
# - false = non-VAT registered business (no VAT line in checkout, final prices only)
# - true  = VAT registered business (tax settings from admin are applied)
BUSINESS_VAT_REGISTERED=false

STORE_LEGAL_NAME=Your Company SRL
STORE_CUI=RO12345678
STORE_ADDRESS=Your street, number, city, county, postal code, Romania
CONTACT_EMAIL=contact@your-domain.ro
SUPPORT_EMAIL=support@your-domain.ro
COURIER_CLAIMS_EMAIL=claims@your-domain.ro

# =============================================================================
# AUTH PROVIDERS (OPTIONAL)
# =============================================================================
# Keep both naming styles for compatibility in this codebase
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional admin bootstrap vars (do not use in production unless intentional)
USE_ENV_ADMIN=false
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
SKIP_ADMIN_VALIDATION=false

# =============================================================================
# MONITORING / ANALYTICS (OPTIONAL)
# =============================================================================
LOG_LEVEL=info
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
ENABLE_ANALYTICS=true
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

FACEBOOK_PIXEL_ID=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_PIXEL_ID=
TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=

# Romanian SEO / GSC
GSC_SERVICE_ACCOUNT_EMAIL=
GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----"
GSC_SITE_URL=https://www.your-domain.ro

# =============================================================================
# AI / CONTENT (OPTIONAL)
# =============================================================================
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER=openai
AI_MODEL=gpt-5-mini
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7
AI_ENHANCEMENT_ENABLED=false
AI_PRIMARY_PROVIDER=openai
AI_PRIMARY_MODEL=gpt-5-mini
AI_SECONDARY_PROVIDER=openai
AI_SECONDARY_MODEL=gpt-5-mini
AI_FALLBACK_MODEL=gpt-4o
USE_SIMPLIFIED_BLOG_PROMPTS=true

# =============================================================================
# UPLOADS / BACKGROUND JOBS (OPTIONAL)
# =============================================================================
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=
UPLOADTHING_TOKEN=
NEXT_PUBLIC_TINYMCE_API_KEY=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# =============================================================================
# RATE LIMIT / DEBUG / FEATURE FLAGS (OPTIONAL)
# =============================================================================
RATE_LIMIT_PROVIDER=memory
RATE_LIMIT_API_REQUESTS=100
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_AUTH_ATTEMPTS=5
RATE_LIMIT_AUTH_BLOCK_MS=900000

ENABLE_AUTH_DEBUG=false
ENABLE_CART_LOGS=false
ENABLE_COMPRESSION=true
ENABLE_PERFORMANCE_LOGS=false
ENABLE_SW_LOGS=false
DISABLE_PINO=false
ENABLE_PINO=true
DB_LOGGING=false
DEBUG=
DEBUG_CATEGORIES=
DEBUG_SECRET=

USE_MOCK_DATA=false
FORCE_SENTRY=false
CI=false
VERCEL=
VERCEL_ENV=
VERCEL_URL=
PORT=3000

# Optional emergency/ops vars
TEST_EMAIL=
TEST_VAR=
ALERT_EMAIL=
ALERT_EMAILS=
ALERT_CHANNELS=
ALERT_COOLDOWN_PERIOD=300
CRITICAL_ALERT_EMAILS=
CRITICAL_ALERT_PHONES=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
SLACK_WEBHOOK_URL=
SLACK_ALERT_WEBHOOK_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# =============================================================================
# ADVANCED OPTIONAL (CODE-REFERENCED, SAFE DEFAULTS)
# =============================================================================
# Analytics simulation helpers
ANALYTICS_CONVERSION_MULTIPLIER=25
ANALYTICS_CONVERSION_SIMULATION=0.9

# Archival / replica / horizontal scaling
ARCHIVE_DATABASE_URL=
DATABASE_REPLICAS=
ENABLE_LOAD_BALANCING=false
LOAD_BALANCER_ALGORITHM=round_robin
LOAD_BALANCER_INSTANCES=
SESSION_AFFINITY=false
AUTO_SCALING_MIN_REPLICAS=1
AUTO_SCALING_MAX_REPLICAS=3
AUTO_SCALING_UP_THRESHOLD=80
AUTO_SCALING_DOWN_THRESHOLD=30
AUTO_SCALING_COOLDOWN_MINUTES=5

# CDN / static delivery
CDN_ENABLED=false
CDN_BASE_URL=
CDN_STATIC_DOMAIN=
CDN_IMAGES_DOMAIN=
CDN_UPLOADS_DOMAIN=
CDN_ASSETS_DOMAIN=
CDN_TOKEN_SECRET=
CDN_SIGNED_URLS=false
NEXT_PUBLIC_CDN_DOMAIN=
NEXT_PUBLIC_CDN_FALLBACK_DOMAIN=

# Cart/network client tuning
NEXT_PUBLIC_CART_FETCH_RETRIES=3
NEXT_PUBLIC_CART_TIMEOUT_MS=10000

# Health / monitoring thresholds
ENABLE_MONITORING=true
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000
PERFORMANCE_ALERTS_ENABLED=false
SLOW_QUERY_THRESHOLD=1000
MAX_SLOW_QUERIES=20
MAX_RESPONSE_TIME=5000
MAX_MEMORY_USAGE=1024
MAX_CPU_USAGE=80
MAX_ERROR_RATE=5
MAX_QUEUE_LENGTH=1000
MIN_CACHE_HIT_RATE=60
MAX_RETRIES=3
REJECTION_BUFFER_PERCENTAGE=10

# User cache / archival behavior
USER_CACHE_PROFILE_TTL=300
USER_CACHE_SEARCH_TTL=300
USER_CACHE_ANALYTICS_TTL=300
USER_CACHE_SEGMENT_TTL=300
USER_CACHE_STATS_TTL=300
USER_ARCHIVAL_INACTIVE_DAYS=365
USER_ARCHIVAL_RETENTION_DAYS=1095
USER_ARCHIVAL_BATCH_SIZE=100
USER_ARCHIVAL_COMPRESSION=true

# Third-party optional keys
AWS_S3_BUCKET=
CURRENCY_API_KEY=
FIXER_API_KEY=
JWT_AUDIENCE=
JWT_ISSUER=

# Runtime-provided by hosting/OS (usually do not set manually)
HOME=
HOSTNAME=
