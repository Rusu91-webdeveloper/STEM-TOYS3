# Dockerfile for Railway deployment of Inngest Server
# This runs the standalone Inngest endpoint to bypass Vercel timeouts

FROM node:18-alpine

# Install OpenSSL for Prisma
RUN apk add --no-cache openssl libc6-compat

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./
COPY prisma ./prisma/

# Install root dependencies (includes TypeScript, Prisma, tsx, etc.)
RUN npm install --production=false

# Generate Prisma client
RUN npx prisma generate

# Copy TypeScript config
COPY tsconfig*.json ./

# Copy necessary source directories (TypeScript files)
COPY inngest ./inngest/
COPY lib ./lib/
COPY types ./types/

# Copy inngest-server
COPY inngest-server ./inngest-server/

# Install inngest-server dependencies (keep dev dependencies for tsx)
WORKDIR /app/inngest-server
RUN npm install

# Back to root for runtime
WORKDIR /app

# Expose port (Railway will override with PORT env var)
EXPOSE ${PORT:-3001}

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:${PORT:-3001}/health', (r) => { process.exit(r.statusCode === 200 ? 0 : 1); });"

# Start the server using tsx to handle TypeScript imports
CMD ["npx", "tsx", "inngest-server/server.ts"]

