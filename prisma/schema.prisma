  productCategories   String[]  @default([])

  // Status and Approval
  isActive            Boolean   @default(true)
  status              String    @default("PENDING")
  approvedAt          DateTime?
  approvedBy          String?
  rejectionReason     String?

  // Financial Terms
  commissionRate      Float     @default(15.0) // Percentage
  paymentTerms        Int       @default(30)   // Days
  minimumOrderValue   Float     @default(0)

  // Romanian Compliance
  adresaSediu               String?
  anpcApproval              Boolean @default(false)
  educationalCertification  String?
  iscApproval               Boolean @default(false)
  romanianBankAccount       String?
  romanianComplianceStatus  String  @default("PENDING")
