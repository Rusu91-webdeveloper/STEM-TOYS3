  responderType     ResponderType
  content           String
  isInternal        Boolean               @default(false)
  attachments       String[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  attachmentDetails Json?
  responder         User                  @relation("TicketResponder", fields: [responderId], references: [id])
  ticket            SupplierSupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([responderId])
  @@index([responderType])
  @@index([createdAt])
}

// Supplier Performance Tracking Models
model SupplierPerformanceMetrics {
  id                    String   @id @default(cuid())
  supplierId           String
  periodStart          DateTime
  periodEnd            DateTime
  totalOrders          Int      @default(0)
  fulfilledOrders      Int      @default(0)
  onTimeDeliveryRate   Float    @default(0) // Percentage 0-100
  averageDeliveryDays  Float?   // Average actual delivery time
  qualityScore         Float    @default(0) // Average rating from reviews 0-5
  returnRate           Float    @default(0) // Percentage of orders returned
  customerSatisfaction Float    @default(0) // Average customer satisfaction 0-5
  totalRevenue         Float    @default(0)
  commissionEarned     Float    @default(0)
  fulfillmentRate      Float    @default(0) // Percentage of orders fulfilled successfully
  responseTimeHours    Float?   // Average response time to admin queries
  issueResolutionRate  Float    @default(0) // Percentage of support issues resolved
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  supplier             Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, periodStart, periodEnd])
  @@index([supplierId])
  @@index([periodStart])
  @@index([periodEnd])
  @@index([onTimeDeliveryRate])
  @@index([qualityScore])
  @@index([fulfillmentRate])
}

model SupplierOrderTracking {
  id                    String            @id @default(cuid())
  supplierOrderId      String            @unique // One tracking record per supplier order
  orderId              String
  orderItemId          String
  status               String            @default("PENDING")
  estimatedDeliveryDate DateTime?
  actualDeliveryDate   DateTime?
  shippedDate          DateTime?
  trackingNumber       String?
  carrier              String?
  qualityRating        Int?              // 1-5 scale
  deliveryRating       Int?              // 1-5 scale
  customerFeedback     String?
  issuesReported       String[]           @default([])
  resolutionStatus     String?           // RESOLVED, PENDING, ESCALATED
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  supplierOrder        SupplierOrder     @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([estimatedDeliveryDate])
  @@index([actualDeliveryDate])
  @@index([qualityRating])
}

