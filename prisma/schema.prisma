// Automation and Campaign Models
model AutomationWorkflow {
  id                String   @id @default(cuid())
  name              String
  type              String
  status            String   @default("active")
  customerId        String
  currentStep       Int      @default(0)
  totalSteps        Int
  nextExecutionDate DateTime
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([type])
  @@index([nextExecutionDate])
}

model Campaign {
  id                    String                @id @default(cuid())
  name                  String
  type                  String
  status                String                @default("draft")
  startDate             DateTime
  endDate               DateTime
  discountPercent       Float?
  minimumOrderAmount    Float?
  maximumDiscountAmount Float?
  applicableCategories  String[]              @default([])
  applicableProducts    String[]              @default([])
  customerSegments      String[]              @default([])
  maxUses               Int?
  currentUses           Int                   @default(0)
  metadata              Json?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  applications          CampaignApplication[]

  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([type])
}

model CampaignApplication {
  id             String   @id @default(cuid())
  campaignId     String
  orderId        String?
  customerId     String
  discountAmount Float
  appliedAt      DateTime @default(now())
  metadata       Json?
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  order          Order?   @relation(fields: [orderId], references: [id])
  customer       User     @relation(fields: [customerId], references: [id])

  @@index([campaignId])
  @@index([customerId])
  @@index([appliedAt])
}

model PerformanceMetric {
  id        String   @id @default(cuid())
  cls       Float    @default(0)
  fid       Float    @default(0)
  fcp       Float    @default(0)
  lcp       Float    @default(0)
  ttfb      Float    @default(0)
  timestamp DateTime @default(now())
  url       String
  userAgent String   @default("")
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([timestamp])
  @@index([url])
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OrderStatusHistory {
  id         String      @id @default(cuid())
  orderId    String
  fromStatus OrderStatus
  toStatus   OrderStatus
  reason     String?
  notes      String?
  updatedBy  String?
  createdAt  DateTime    @default(now())
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([toStatus])
  @@index([createdAt])
}

// Image Processing Models
model ImageMetadata {
  id                String               @id @default(cuid())
  originalUrl       String
  filename          String
  fileSize          Int
  width             Int?
  height            Int?
  format            String
  uploadedAt        DateTime             @default(now())
  processedSizes    Json?
  optimizationStats Json?
  tags              String[]
  alt               String?
  description       String?
  metadata          Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  processingLogs    ImageProcessingLog[]

  @@index([originalUrl])
  @@index([format])
  @@index([uploadedAt])
}

model ImageProcessingLog {
  id           String        @id @default(cuid())
  imageId      String
  operation    String
  status       String
  details      Json?
  startedAt    DateTime      @default(now())
  completedAt  DateTime?
  errorMessage String?
  image        ImageMetadata @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@index([imageId])
  @@index([operation])
  @@index([status])
  @@index([startedAt])
}
