  // Files and Media
  logo                String?
  catalogUrl          String?
  termsAccepted       Boolean  @default(false)
  privacyAccepted     Boolean  @default(false)

  // Timestamps
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  orders              SupplierOrder[]
  invoices            SupplierInvoice[]
  messages            SupplierMessage[]
  notifications       SupplierNotification[]
  supportTickets      SupplierSupportTicket[]
  products            Product[]
  performanceMetrics  SupplierPerformanceMetrics[]

  @@index([userId])
  @@index([email])
  @@index([companySlug])
  @@index([isActive])
  @@index([status])
  @@index([businessCountry])
  @@index([commissionRate])
  @@index([minimumOrderValue])
