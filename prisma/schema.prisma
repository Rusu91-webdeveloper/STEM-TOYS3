generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  name                String?
  email               String               @unique
  phone               String?
  password            String
  role                Role                 @default(CUSTOMER)
  emailVerified       DateTime?
  verificationToken   String?
  isActive            Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  // Multi-tenant architecture fields
  tenantId            String?
  organizationId      String?

  // GDPR Compliance fields
  consentGiven        Boolean              @default(false)
  consentDate         DateTime?
  dataRetention       Json?                // Retention policies and schedules
  anonymized          Boolean              @default(false)

  // Romanian Market Compliance fields
  cui                 String?              // Romanian tax identification number
  cnp                 String?              // Romanian personal numerical code
  serieCi             String?              // Romanian ID card series
  numarCi             String?              // Romanian ID card number
  eliberatDe          String?              // Romanian ID card issuer
  eliberatLa          DateTime?            // Romanian ID card issue date
  valabilPanaLa       DateTime?            // Romanian ID card expiry date
  adresaDomiciliu     Json?                // Romanian registered address
  codPostal           String?              // Romanian postal code
  judet              String?              // Romanian county
  localitate         String?              // Romanian locality
  isRomanianResident  Boolean              @default(false)

  // Advanced Security Features (Phase 3.2)
  lastLoginAt         DateTime?            // Last successful login timestamp
  failedLoginAttempts Int                  @default(0) // Failed login attempts counter
  accountLocked       Boolean              @default(false) // Account lockout status
  lockoutUntil        DateTime?            // Account lockout expiry time
  twoFactorEnabled    Boolean              @default(false) // 2FA enabled status
  securityQuestions   Json?                // Encrypted security questions for recovery

  // User Segmentation & Intelligence (Phase 4.1)
  segment             UserSegment          @default(NEW) // User segment for marketing
  tags                String[]             @default([]) // Flexible categorization tags
  preferences         Json?                // User settings and marketing preferences
  lifecycleStage      LifecycleStage       @default(AWARENESS) // Customer lifecycle stage
  segmentUpdatedAt    DateTime?            // Last segment update timestamp
  churnRiskScore      Float?               @default(0) // Churn prediction score 0-100

  // Behavioral Analytics (Phase 4.2)
  totalPageViews      Int                  @default(0) // Total page views across sessions
  totalTimeSpent      Int                  @default(0) // Total time spent in minutes
  avgSessionDuration  Float?               @default(0) // Average session duration in minutes
  lastActivityAt      DateTime?            // Last user activity timestamp
  purchaseFrequency   Float?               @default(0) // Average purchases per month
  avgOrderValue       Float?               @default(0) // Average order value
  lifetimeValue       Float                @default(0) // Customer lifetime value
  referralCount       Int                  @default(0) // Number of referrals made
  socialEngagementScore Float?             @default(0) // Social media engagement score
  recommendationClicks Int                 @default(0) // Product recommendation clicks
  wishlistSize        Int                  @default(0) // Current wishlist size

  // Romanian Market Intelligence (Phase 4.3)
  regionalPreference  String?              // Preferred Romanian region (Transylvania, Moldova, etc.)
  seasonalPatterns    Json?                // Seasonal buying patterns for Romanian holidays
  productCategoryPrefs String[]            @default([]) // Preferred product categories
  ageGroup            String?              // Age group (18-25, 26-35, etc.)
  educationLevel      String?              // Education level for demographic analysis
  paymentMethodPrefs  String[]             @default([]) // Preferred payment methods (card, cash, installments)
  deliveryTimeExpectation Int?             @default(3) // Expected delivery time in days
  priceSensitivity    Float?               @default(0.5) // Price sensitivity score 0-1
  brandLoyaltyScore   Float?               @default(0) // Brand loyalty score 0-100

  // Scalability Infrastructure (Phase 5.1)
  shardId             String?              // Database shard identifier for horizontal scaling
  replicaId           String?              // Read replica identifier for load distribution
  cacheKey            String?              // Redis cache key for user data caching
  cacheVersion        Int                  @default(1) // Cache version for invalidation
  lastCacheUpdate     DateTime?            // Last time cache was updated
  dataArchiveStatus   String               @default("ACTIVE") // ACTIVE, ARCHIVED, DELETED

  // Relations
  tenant              Tenant?              @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  organization        Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  shard               UserShard?           @relation(fields: [shardId], references: [shardId], onDelete: SetNull)
  consentLogs         ConsentLog[]
  addresses           Address[]
  blogs               Blog[]
  contentVersions     ContentVersion[]
  couponsCreated      Coupon[]             @relation("CouponCreatedBy")
  couponUsages        CouponUsage[]
  digitalDownloads    DigitalDownload[]
  orders              Order[]
  passwordResetTokens PasswordResetToken[]
  paymentCards        PaymentCard[]
  returns             Return[]
  reviews             Review[]
  tickets             Ticket[]
  wishlistItems       Wishlist[]
  emailEvents         EmailEvent[]
  emailSequences      EmailSequence[]
  emailSequenceUsers  EmailSequenceUser[]
  supplierMessages    SupplierMessage[]    @relation("MessageSender")
  supplierTickets     SupplierSupportTicket[] @relation("TicketAssignedTo")
  supplierTicketResponses SupplierTicketResponse[] @relation("TicketResponder")
  sessions            Session[]
  campaignApplications CampaignApplication[]
  suppliers           Supplier[]
  twoFactor           TwoFactor?
  securityEventLogs   SecurityEventLog[]

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([role, isActive])

  // Multi-tenant indexes for performance
  @@index([tenantId])
  @@index([organizationId])
  @@index([tenantId, isActive])
  @@index([organizationId, isActive])
  @@index([tenantId, role])
  @@index([organizationId, role])

  // Security indexes
  @@index([failedLoginAttempts])
  @@index([accountLocked])
  @@index([twoFactorEnabled])
  @@index([lockoutUntil])

  // Segmentation & Intelligence indexes (Phase 4)
  @@index([segment])
  @@index([lifecycleStage])
  @@index([segmentUpdatedAt])
  @@index([churnRiskScore])
  @@index([lastActivityAt])
  @@index([lifetimeValue])
  @@index([segment, lifecycleStage])
  @@index([segment, tenantId])
  @@index([lifecycleStage, tenantId])
  @@index([churnRiskScore, segment])
  @@index([regionalPreference])
  @@index([ageGroup])
  @@index([educationLevel])

  // Scalability Infrastructure indexes (Phase 5.1)
  @@index([shardId])
  @@index([replicaId])
  @@index([cacheKey])
  @@index([cacheVersion])
  @@index([dataArchiveStatus])
  @@index([shardId, tenantId])
  @@index([replicaId, shardId])
  @@index([dataArchiveStatus, updatedAt])
}

model TwoFactor {
  id            String   @id @default(cuid())
  userId        String   @unique
  secret        String   // TOTP secret key (encrypted)
  backupCodes   String[] // Encrypted backup codes
  algorithm     String   @default("SHA1") // TOTP algorithm
  digits        Int      @default(6) // Number of digits
  period        Int      @default(30) // Time period in seconds
  isVerified    Boolean  @default(false) // Whether 2FA is verified and active
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastUsedAt    DateTime? // Last time 2FA was used

  // Relations
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isVerified])
}

model SegmentationRule {
  id            String         @id @default(cuid())
  name          String         // Rule name for identification
  description   String?        // Rule description
  segment       UserSegment    // Target segment to assign
  lifecycleStage LifecycleStage? // Target lifecycle stage
  isActive      Boolean        @default(true) // Whether rule is active
  priority      Int            @default(0) // Execution priority (higher = first)

  // Rule conditions (JSON structure for flexible conditions)
  conditions    Json           // Conditions that must be met

  // Examples of conditions:
  // {
  //   "lifetimeValue": { "operator": "gte", "value": 500 },
  //   "purchaseFrequency": { "operator": "gte", "value": 2 },
  //   "lastActivityAt": { "operator": "lt", "value": "30_days_ago" },
  //   "totalPageViews": { "operator": "gte", "value": 50 }
  // }

  // Rule metadata
  tags          String[]       @default([]) // Rule categorization tags
  tenantId      String?        // Multi-tenant support
  createdBy     String         // Admin who created the rule
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relations
  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([segment])
  @@index([lifecycleStage])
  @@index([isActive])
  @@index([priority])
  @@index([tenantId])
  @@index([createdBy])
  @@index([segment, isActive])
  @@index([lifecycleStage, isActive])
}

model SecurityEventLog {
  id          String          @id @default(cuid())
  userId      String?
  eventType   SecurityEventType
  ipAddress   String?
  userAgent   String?
  location    Json?           // Geolocation data
  details     Json?           // Additional event details
  success     Boolean         @default(true) // Whether the action succeeded
  riskScore   Int             @default(0) // Risk score 0-100
  sessionId   String?         // Associated session ID
  metadata    Json?           // Additional metadata
  createdAt   DateTime        @default(now())

  // Relations
  user        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  @@index([ipAddress])
  @@index([success])
  @@index([riskScore])
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGE
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_COMPLETE
  ACCOUNT_LOCKOUT
  ACCOUNT_UNLOCK
  TWO_FACTOR_SETUP
  TWO_FACTOR_VERIFY
  TWO_FACTOR_DISABLE
  SUSPICIOUS_ACTIVITY
  SECURITY_QUESTION_SETUP
  SECURITY_QUESTION_VERIFY
  ACCOUNT_RECOVERY
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expires   DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [email], references: [email], onDelete: Cascade)

  @@index([email])
  @@index([token])
}

model Tenant {
  id                String    @id @default(cuid())
  name              String
  slug              String    @unique
  description       String?
  logo              String?
  domain            String?   @unique
  isActive          Boolean   @default(true)
  settings          Json?     // Tenant-specific settings
  limits            Json?     // Usage limits and quotas
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  users             User[]
  organizations     Organization[]
  segmentationRules SegmentationRule[]
  emailTriggers     EmailTrigger[]

  @@index([slug])
  @@index([isActive])
}

model Organization {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  description     String?
  logo            String?
  domain          String?   @unique
  tenantId        String
  isActive        Boolean   @default(true)
  settings        Json?     // Organization-specific settings
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users           User[]

  @@index([slug])
  @@index([tenantId])
  @@index([isActive])
}

model UserShard {
  id                String   @id @default(cuid())
  shardId           String   @unique // Unique identifier for the shard
  name              String   // Human-readable name (e.g., "shard-us-east-1")
  description       String?
  databaseUrl       String   // Database connection URL for this shard
  isActive          Boolean  @default(true) // Whether this shard is active
  capacity          Int      @default(1000000) // Maximum users this shard can handle
  currentUsers      Int      @default(0) // Current number of users on this shard
  region            String   // AWS region or data center location
  readReplicas      Json?    // Array of read replica configurations
  writeEndpoint     String   // Primary write endpoint
  readEndpoints     String[] @default([]) // Read replica endpoints
  healthStatus      String   @default("HEALTHY") // HEALTHY, DEGRADED, UNHEALTHY
  lastHealthCheck   DateTime?
  failoverPriority  Int      @default(0) // Priority for failover (higher = preferred)
  backupSchedule    Json?    // Backup configuration
  migrationStatus   String   @default("NONE") // NONE, MIGRATING, MIGRATED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  users             User[]

  @@index([shardId])
  @@index([isActive])
  @@index([region])
  @@index([healthStatus])
  @@index([failoverPriority])
  @@index([migrationStatus])
}

model ConsentLog {
  id              String       @id @default(cuid())
  userId          String
  action          ConsentAction
  consentType     String       // marketing, essential, analytics, etc.
  consentGiven    Boolean
  ipAddress       String?
  userAgent       String?
  consentDetails  Json?        // Additional consent information
  validUntil      DateTime?    // For time-limited consents
  createdAt       DateTime     @default(now())

  // Relations
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([consentType])
  @@index([createdAt])
  @@index([userId, consentType])
}

enum ConsentAction {
  GRANTED
  WITHDRAWN
  UPDATED
  EXPIRED
}

model DataRetentionPolicy {
  id              String   @id @default(cuid())
  category        String   @unique // personal_data, marketing_data, analytics_data, logs
  retentionPeriod Int      // Days to retain data
  autoDelete      Boolean  @default(true)
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([autoDelete])
}

model Address {
  id           String  @id @default(cuid())
  userId       String
  name         String
  fullName     String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String
  phone        String
  isDefault    Boolean @default(false)

  // Romanian Address Compliance fields
  judet        String? // Romanian county
  localitate   String? // Romanian locality
  codPostal    String? // Romanian postal code (6 digits)
  sector       String? // Bucharest sector (1-6)
  isBillingAddress Boolean @default(false) // For Romanian tax compliance

  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders       Order[]
}

model PaymentCard {
  id                String   @id @default(cuid())
  userId            String
  cardholderName    String
  lastFourDigits    String
  encryptedCardData String
  encryptedCvv      String?
  expiryMonth       String
  expiryYear        String
  cardType          String
  billingAddressId  String?
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  parentId    String?
  image       String?
  isActive    Boolean    @default(true)
  metadata    Json?
  blogs       Blog[]
  parent      Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryToCategory")
  products    Product[]

  @@index([slug])
}

model Product {
  id                   String          @id @default(cuid())
  name                 String
  slug                 String          @unique
  description          String?
  price                Float
  compareAtPrice       Float?
  sku                  String?         @unique
  images               String[]
  categoryId           String?
  tags                 String[]
  attributes           Json?
  metadata             Json?
  isActive             Boolean         @default(true)
  status               ProductStatus   @default(IN_PENDING)
  featured             Boolean         @default(false)
  stockQuantity        Int             @default(0)
  reservedQuantity     Int             @default(0)
  reorderPoint         Int?
  weight               Float?
  dimensions           Json?
  averageRating        Float?
  reviewCount          Int             @default(0)
  totalSold            Int             @default(0)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  barcode              String?
  costPrice            Float?
  importDuties         Float?          @default(0)
  shippingCost         Float?          @default(0)
  storageCost          Float?          @default(0)
  packagingCost        Float?          @default(0)
  laborCost            Float?          @default(0)
  qualityControlCost   Float?          @default(0)
  paymentProcessingFee Float?          @default(2.9)
  customerServiceCost  Float?          @default(0)
  operationalOverhead  Float?          @default(0)
  ageGroup             String?
  stemDiscipline       String?
  marketingCosts       MarketingCost[]
  orderItems           OrderItem[]
  category             Category?       @relation(fields: [categoryId], references: [id])
  productCosts         ProductCost[]
  reviews              Review[]
  supplierOrders       SupplierOrder[]
  wishlistItems        Wishlist[]
  supplier             Supplier?       @relation(fields: [supplierId], references: [id])
  supplierId           String?

  @@index([categoryId])
  @@index([slug])
  @@index([isActive])
  @@index([status])
  @@index([featured])
  @@index([costPrice], map: "idx_product_cost_price")
  @@index([costPrice, price], map: "idx_product_cost_price_analytics")
  @@index([averageRating])
  @@index([categoryId, isActive])
  @@index([isActive, status])
  @@index([createdAt])
  @@index([featured, createdAt(sort: Desc)])
  @@index([isActive, featured])
  @@index([name])
  @@index([price])
  @@index([price, isActive])
  @@index([stockQuantity])
  @@index([stockQuantity, isActive])
  @@index([ageGroup])
  @@index([stemDiscipline])
  @@map("Product")
}

model MarketingCost {
  id                 String   @id @default(cuid())
  productId          String
  date               DateTime
  googleAdsCost      Float    @default(0)
  facebookAdsCost    Float    @default(0)
  seoCost            Float    @default(0)
  influencerCost     Float    @default(0)
  totalMarketingCost Float    @default(0)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([date])
  @@index([productId, date])
  @@map("MarketingCost")
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model Blog {
  id           String       @id @default(cuid())
  title        String
  slug         String       @unique
  excerpt      String
  content      String
  coverImage   String?
  categoryId   String
  authorId     String
  tags         String[]
  metadata     Json?
  isPublished  Boolean      @default(false)
  publishedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  readingTime  Int?
  stemCategory StemCategory @default(GENERAL)
  author       User         @relation(fields: [authorId], references: [id])
  category     Category     @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([authorId])
  @@index([stemCategory])
}

model Book {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  author       String
  description  String
  price        Float         @default(50)
  coverImage   String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  metadata     Json?
  isDigital    Boolean       @default(true)
  digitalFiles DigitalFile[]
  orderItems   OrderItem[]
  languages    Language[]    @relation("BookToLanguage")
}

model DigitalFile {
  id        String            @id @default(cuid())
  bookId    String
  fileName  String
  fileUrl   String
  fileSize  Int
  format    String
  language  String
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  downloads DigitalDownload[]
  book      Book              @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, format, language])
  @@index([bookId])
  @@index([format])
  @@index([language])
}

model Language {
  id          String  @id @default(cuid())
  name        String  @unique
  code        String  @unique
  nativeName  String?
  isAvailable Boolean @default(true)
  books       Book[]  @relation("BookToLanguage")
}

model Order {
  id                    String          @id @default(cuid())
  orderNumber           String          @unique
  userId                String
  total                 Float
  subtotal              Float
  tax                   Float
  shippingCost          Float
  discountAmount        Float           @default(0)
  couponCode            String?
  couponId              String?
  status                OrderStatus     @default(PROCESSING)
  paymentStatus         PaymentStatus   @default(PENDING)
  paymentMethod         String
  notes                 String?
  shippingAddressId     String
  billingAddressId      String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  deliveredAt           DateTime?
  // Legacy Stripe fields (keep for backward compatibility)
  stripePaymentIntentId String?
  // Netopia payment fields
  netopiaTransactionId  String?
  netopiaInvoiceId      String?
  netopiaPaymentUrl     String?
  completedAt           DateTime?
  fulfilledAt           DateTime?
  shippedAt             DateTime?
  trackingNumber        String?
  carrier               String?
  estimatedDelivery     DateTime?
  priority              String          @default("MEDIUM")
  tags                  String[]        @default([])
  updatedBy             String?
  coupon                Coupon?         @relation(fields: [couponId], references: [id])
  shippingAddress       Address         @relation(fields: [shippingAddressId], references: [id])
  user                  User            @relation(fields: [userId], references: [id])
  items                 OrderItem[]
  returns               Return[]
  supplierOrders        SupplierOrder[]
  statusHistory         OrderStatusHistory[]
  campaignApplications  CampaignApplication[]

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([orderNumber])
  @@index([couponId])
}

model OrderItem {
  id                String                @id @default(cuid())
  orderId           String
  productId         String?
  name              String
  price             Float
  quantity          Int
  returnStatus      OrderItemReturnStatus @default(NONE)
  bookId            String?
  downloadCount     Int                   @default(0)
  downloadExpiresAt DateTime?
  isDigital         Boolean               @default(false)
  maxDownloads      Int                   @default(5)
  downloads         DigitalDownload[]
  book              Book?                 @relation(fields: [bookId], references: [id])
  order             Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product?              @relation(fields: [productId], references: [id])
  returns           Return[]
  reviews           Review[]
  supplierOrders    SupplierOrder[]

  @@index([orderId])
  @@index([productId])
  @@index([bookId])
}

model StoreSettings {
  id               String   @id @default(cuid())
  storeName        String   @default("TechTots")
  storeUrl         String   @default("https://techtots.com")
  storeDescription String   @default("TechTots is a premier online destination for STEM toys that inspire learning through play.")
  contactEmail     String   @default("info@techtots.com")
  contactPhone     String   @default("+1 (555) 123-4567")
  currency         String   @default("usd")
  timezone         String   @default("america-new_york")
  dateFormat       String   @default("mm-dd-yyyy")
  weightUnit       String   @default("lb")
  metaTitle        String   @default("TechTots | STEM Toys for Curious Minds")
  metaDescription  String   @default("Discover the best STEM toys for curious minds at TechTots. Educational toys that make learning fun for children of all ages.")
  metaKeywords     String   @default("STEM toys, educational toys, science toys, technology toys, engineering toys, math toys")
  shippingSettings Json?
  paymentSettings  Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  metadata         Json?
  taxSettings      Json?
}

model StoreSettingsBackup {
  id           String   @id @default(cuid())
  name         String
  description  String?
  settingsData Json
  version      String   @default("1.0")
  createdBy    String
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([createdBy])
}

model Return {
  id           String       @id @default(cuid())
  userId       String
  orderId      String
  orderItemId  String
  reason       ReturnReason
  details      String?
  status       ReturnStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  refundError  String?
  refundStatus String?
  order        Order        @relation(fields: [orderId], references: [id])
  orderItem    OrderItem    @relation(fields: [orderItemId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([orderId])
  @@index([orderItemId])
}

model Review {
  id          String    @id @default(cuid())
  userId      String
  productId   String
  orderItemId String
  rating      Int       @default(0)
  title       String
  content     String
  createdAt   DateTime  @default(now())
