model EmailTrigger {
  id            String             @id @default(cuid())
  name          String             // Trigger name for identification
  description   String?            // Trigger description
  type          EmailTriggerType   // Type of trigger
  status        EmailTriggerStatus @default(DRAFT) // Trigger status

  // Trigger conditions (JSON structure for flexible conditions)
  conditions    Json               // Conditions that must be met to fire

  // Examples of conditions:
  // SEGMENT_ENTER: { "segment": "VIP", "previousSegment": "ACTIVE" }
  // BEHAVIOR_EVENT: { "event": "cart_abandoned", "value": { "minItems": 1 } }
  // TIME_BASED: { "inactiveDays": 30, "segment": "ACTIVE" }
  // LIFECYCLE_CHANGE: { "fromStage": "AWARENESS", "toStage": "CONSIDERATION" }

  // Action to take when trigger fires
  actionType    String             // "send_email", "start_sequence", "update_user"
  actionData    Json               // Action-specific data

  // Examples of actionData:
  // send_email: { "templateId": "welcome-email", "subject": "Welcome to STEM Toys!" }
  // start_sequence: { "sequenceId": "vip-onboarding" }
  // update_user: { "tags": ["special-offer-sent"] }

  // Trigger settings
  priority      Int                @default(0) // Execution priority
  cooldownHours Int                @default(24) // Minimum hours between triggers for same user
  maxExecutions Int?               // Maximum times this trigger can fire per user (null = unlimited)
  isActive      Boolean            @default(false) // Whether trigger is active

  // Targeting
  segmentFilter String?            // Only trigger for users in this segment
  lifecycleFilter String?          // Only trigger for users in this lifecycle stage
  tenantId      String?            // Multi-tenant support

  // Metadata
  tags          String[]           @default([]) // Categorization tags
  createdBy     String             // Admin who created the trigger
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  // Relations
  tenant        Tenant?            @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  executions    EmailTriggerExecution[]

  @@index([type])
  @@index([status])
  @@index([isActive])
  @@index([priority])
  @@index([segmentFilter])
  @@index([lifecycleFilter])
  @@index([tenantId])
  @@index([createdBy])
  @@index([type, isActive])
}

model EmailTriggerExecution {
  id            String       @id @default(cuid())
  triggerId     String       // Which trigger fired
  userId        String       // Which user triggered it
  executionData Json?        // Data about what caused the trigger
  actionResult  Json?        // Result of the action (email sent, sequence started, etc.)
  status        String       @default("pending") // pending, success, failed
  errorMessage  String?      // If status is failed
  executedAt    DateTime     @default(now())

  // Relations
  trigger       EmailTrigger @relation(fields: [triggerId], references: [id], onDelete: Cascade)

  @@index([triggerId])
  @@index([userId])
  @@index([status])
  @@index([executedAt])
  @@index([triggerId, userId])
  @@index([userId, executedAt])
}

